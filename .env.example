# Database Configuration
DATABASE_URI=postgresql://postgres:admin@localhost:5432/mydb

# LLM Provider Selection
# Options: azure (default) or deepseek
LLM_PROVIDER=azure

# Azure OpenAI Configuration (when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://ai-proxy.lab.epam.com
OPENAI_API_VERSION=2025-04-01-preview
MODEL=gpt-4o

# Deepseek Configuration (when LLM_PROVIDER=deepseek)
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEBUG_DEEPSEEK=0  # Set to 1 to enable detailed request/response logging